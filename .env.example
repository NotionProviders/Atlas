APP_NAME="Notion Workspace Atlas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://atlas.notionproviders.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log to stderr so Coolify/Docker can capture output (do not log to files).
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# SQLite works out of the box. Leaving DB_DATABASE unset uses the app's
# database/database.sqlite file — correct both locally and in Docker.
# Switch to pgsql if you add a PostgreSQL resource in Coolify.
DB_CONNECTION=sqlite
# DB_DATABASE=  # optional; defaults to database/database.sqlite

# PostgreSQL (optional — set DB_CONNECTION=pgsql and fill these in Coolify)
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=atlas
# DB_USERNAME=postgres
# DB_PASSWORD=

# No database-backed sessions/cache required for this read-only atlas app.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Notion ingestion — full-access internal integration token used by the
# recursive workspace crawler (atlas:ingest command and the /workspaces form).
# The REST API can't list teamspaces, so seed teamspace roots via MCP get-teams.
NOTION_API_KEY=
NOTION_VERSION=2022-06-28
NOTION_CRAWL_MAX_DEPTH=12
NOTION_CRAWL_MAX_NODES=20000

# Private /console backend (the workspace mapping tool). Set a password to
# enable login; leave blank to keep the console locked.
CONSOLE_PASSWORD=changeme
# Public "/" map (conceptual atlas) + the default map shown inside the console.
ATLAS_PUBLIC_MAP=concept
CONSOLE_DEFAULT_MAP=formosa-ev-hq

# Migrations module (pull a workspace out of Loop etc. via the browser extension).
# All optional — sane defaults are baked into config/migration.php.
MIGRATION_PAIRING_TTL=600
MIGRATION_STORAGE_ROOT=migrations
MIGRATION_MAX_NODES=20000
MIGRATION_MAX_BATCH=250
